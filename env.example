# Per-machine environment for this dotfiles repo.
#
# Copy this file to ~/.config/dotfiles/env on each machine and edit the values
# for that machine. The per-machine file is gitignored (see .gitignore) and
# must never be committed: it carries machine-specific personal values
# (usernames, hostnames, LAN endpoints) that stay out of the public repo.
#
# Format: one KEY=VALUE per line, '#' starts a comment (whole-line only, no
# inline comments), no quoting rules beyond the value itself. The same file is
# read by nix (via the dotfiles-env flake input), wezterm (at runtime), fish
# (conf.d loader) and zsh (sourced from .zshrc), so keep it plain KEY=VALUE.
#
# Keep secrets OUT of this file - it is plaintext. Credentials stay in the OS
# secret store / pass, per the repo's "Keys and credentials" posture.

# --- nix ---------------------------------------------------------------------
# Local username of this machine's main user. Every nix host config reads it
# (home.username / home.homeDirectory / wsl.defaultUser).
DOTFILES_USERNAME=your-username

# Role of this machine among the flake's hosts: laptop, server, or wsl.
# Used by nix/setup-server.sh to pick the homeConfigurations output.
DOTFILES_HOST_ROLE=laptop

# Hostname (or ssh alias) of the home server. Used by wezterm's ssh domain and
# by the fish joy-console function.
DOTFILES_SERVER_HOST=server-host

# Username to ssh into the home server as. On the server this equals
# DOTFILES_USERNAME.
DOTFILES_SERVER_USER=server-user

# --- fish joy-console ---------------------------------------------------------
# User that owns the joy-console container on the server (the sudo -u target
# of the podman exec).
JOY_CONSOLE_CONTAINER_USER=container-user

# Name of the joy-console container on the server (the podman exec target).
JOY_CONSOLE_CONTAINER=console-container

# Home directory of the container user inside the container.
JOY_CONSOLE_CONTAINER_HOME=/home/container-user

# --- zsh stereo-transcode -----------------------------------------------------
# HTTP endpoint of the stereo transcode service on the LAN.
STEREO_TRANSCODE_ENDPOINT=http://transcode-host:3000

# --- wezterm (Windows / WSL) --------------------------------------------------
# Username for the ssh:wsl domain (ssh from Windows into the WSL distro).
WEZTERM_SSH_WSL_USER=wsl-ssh-user

# Old Ubuntu WSL setup - the wsl:ubuntu-fish domain (fish login).
WEZTERM_WSL_DISTRO=Ubuntu
WEZTERM_WSL_FISH_USER=wsl-fish-user
WEZTERM_WSL_FISH_CWD=/home/wsl-fish-user

# Old Ubuntu WSL setup - the wsl:ubuntu-bash domain (bash login).
WEZTERM_WSL_BASH_USER=wsl-bash-user
WEZTERM_WSL_BASH_CWD=/home/wsl-bash-user

# NixOS-WSL setup - the WSL system user (matches DOTFILES_USERNAME on the wsl
# host).
WEZTERM_WSL_SYSTEM_USER=wsl-system-user

# Absolute path of Git Bash's bash.exe, for the launch menu Git Bash entry.
WEZTERM_GIT_BASH_PATH=C:\Users\your-user\scoop\apps\git\current\bin\bash.exe
