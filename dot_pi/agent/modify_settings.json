#!/bin/sh
# Reimplements the sibling nix-config repo's modules/dev/pi.nix's
# piSettings activation script as a
# chezmoi modify_ script: settings.json mixes genuinely-user fields (theme,
# hideThinkingBlock, steeringMode, followUpMode, images.blockImages,
# terminal.showImages, quietStartup, collapseChangelog) with fields pi itself
# writes at runtime (defaultProvider/defaultModel, lastChangelogVersion,
# packages, extensions). chezmoi feeds the existing target content on stdin
# (empty if the file doesn't exist yet) and expects the new content on
# stdout - same merge direction as the original
# `jq -s '.[0] * .[1]' "$settings_file" defaults.json`: existing on the left,
# managed defaults on the right, so defaults win on overlapping keys and
# every pi-written field neither side shares survives untouched. `packages`
# is the exception to "defaults win": it is a union of the existing array and
# `managed_packages` below, so packages pi adds itself are never erased. The
# npm specs are deliberately unpinned (versioned specs are pinned and skipped
# by `pi update`). `extensions` stays absent: nothing here registers those.
set -eu

defaults='{
  "theme": "rose-pine-moon",
  "hideThinkingBlock": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "images": {
    "blockImages": false
  },
  "terminal": {
    "showImages": false
  },
  "quietStartup": true,
  "collapseChangelog": true
}'

managed_packages='[
  "npm:pi-web-access",
  "npm:@ryan_nookpi/pi-extension-codex-fast-mode",
  "git:github.com/algal/pi-openai-server-compaction"
]'

existing="$(cat)"
if [ -z "$existing" ]; then
  existing='{}'
fi

printf '%s' "$existing" | jq --argjson defaults "$defaults" --argjson managed "$managed_packages" '
  def src: if type == "object" then .source else . end;
  (.packages // []) as $have
  | (. * $defaults)
  | .packages = $have + [$managed[] | select(. as $m | $have | map(src) | index($m) | not)]
'
