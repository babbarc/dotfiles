{{/* Gate desktop-only dotfiles out of server/wsl, mirroring this repo's own
     current per-host nix `imports` split (laptop's home.nix imports
     wezterm.nix/sway.nix/waybar.nix; server's and wsl's home.nix only
     import modules/dev) rather than inventing a second host-conditional
     mechanism. DOTFILES_HOST_ROLE comes from the same env-ingestion as
     every other per-machine value (.chezmoi.toml.tmpl). */ -}}
{{- if ne .DOTFILES_HOST_ROLE "laptop" }}
.config/wezterm
.config/sway
.config/waybar
{{- end }}

{{/* Now that chezmoi's source root is the repo root (no more .chezmoiroot
     indirection into a chezmoi subdirectory), every plain-named repo-root
     entry that isn't itself chezmoi source content (a dot_-prefixed or
     .chezmoi-prefixed name) is visible to chezmoi's source-state scan and
     must be excluded here, or chezmoi materializes it as a bogus
     literal-named target in the home directory. */ -}}
nvim
pi
wezterm
tests
containers
tmux.conf.local
tmux.service
README.md
AGENTS.md
CLAUDE.md
LICENSE
env.example
